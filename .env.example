# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic — used only by the recovery planner (agent/plan.py).
# If unset, the system falls back to deterministic per-class plans and marks
# affected cases `llm_unavailable`. Recovery continues, degraded.
ANTHROPIC_API_KEY=

# Razorpay TEST MODE credentials. Optional.
# Leave blank to run against the in-memory simulator (providers/mock.py).
# Never put live-mode keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Provider selection: "mock" | "live"
RECOUPER_PROVIDER=mock
